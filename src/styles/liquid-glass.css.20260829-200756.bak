/*
 * Shared Liquid Glass Studio styling.
 * One fixed WebGL2 canvas draws the dark-mode specular/Fresnel layer for all
 * visible surfaces; CSS backdrop-filter supplies the actual DOM blur.
 */

:where(
  .liquid-panel,
  .liquid-button,
  .top-action,
  .chapter-rail,
  .rail-item.is-active,
  .hero-module,
  .segmented,
  .derivation-controls,
  .search-panel,
  .section-header,
  .content-section > .prose,
  .feature-figure,
  .formula-card,
  .derivation,
  .reading-callout,
  .concept-check,
  .unit-switch-panel,
  .split-explanation,
  .inverse-lab,
  .knowledge-map,
  .chapter-summary,
  .exercise-card,
  .completion-panel,
  .source-note,
  .lab-grid,
  .compact-lab,
  .lj-lab
) {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid var(--glass-border);
  background: var(--glass-fill);
  box-shadow:
    inset 0 1px 0 var(--glass-top-edge),
    inset 0 -1px 0 var(--glass-bottom-edge),
    0 12px 38px var(--glass-shadow);
  backdrop-filter: blur(8px) saturate(110%);
  -webkit-backdrop-filter: blur(8px) saturate(110%);
}

/* The entire site uses ONE WebGL context in dark mode. */
.studio-glass-shared-canvas {
  position: fixed;
  inset: 0;
  z-index: 1;
  width: 100vw;
  height: 100vh;
  display: block;
  pointer-events: none;
  background: transparent;
}

/* Glass surfaces sit above the shared optical canvas. */
[data-liquid-glass] {
  position: relative;
}

html[data-theme="dark"] [data-liquid-glass="shared-webgl2"] {
  z-index: 2;
  border-color: rgba(255, 255, 255, 0.014) !important;
  background: rgba(7, 8, 10, 0.24) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.020),
    inset 0 -1px 0 rgba(255,255,255,.006),
    0 16px 48px rgba(0,0,0,.18) !important;
  backdrop-filter: blur(18px) saturate(118%) brightness(.90) !important;
  -webkit-backdrop-filter: blur(18px) saturate(118%) brightness(.90) !important;
}

/* No neon outline: the WebGL layer itself provides the directional rim. */
html[data-theme="dark"] .liquid-button.primary[data-liquid-glass="shared-webgl2"] {
  color: rgba(226, 241, 255, .96) !important;
  background: rgba(58, 135, 214, .20) !important;
  border-color: rgba(112, 184, 255, .12) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08) !important;
}

html[data-theme="dark"] .liquid-button.secondary[data-liquid-glass="shared-webgl2"],
html[data-theme="dark"] .top-action[data-liquid-glass="shared-webgl2"] {
  background: rgba(255,255,255,.022) !important;
  border-color: rgba(255,255,255,.028) !important;
}

/* Light mode remains a restrained frosted-glass fallback. */
:root[data-theme="light"] [data-liquid-glass="frosted"] {
  background: var(--glass-fill);
  border-color: var(--glass-border);
  box-shadow:
    inset 0 1px 0 var(--glass-top-edge),
    inset 0 -1px 0 var(--glass-bottom-edge),
    0 12px 38px var(--glass-shadow);
}

.liquid-button .icon,
.top-action .icon {
  position: relative;
  z-index: 3;
  visibility: visible;
  opacity: 1;
}

.liquid-button,
.top-action,
.rail-item {
  transition:
    transform var(--fast) var(--ease),
    background var(--fast),
    border-color var(--fast),
    box-shadow var(--fast);
}

.liquid-button {
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 0 18px;
  border-radius: 999px;
  cursor: pointer;
}

.liquid-button:hover,
.top-action:hover {
  border-color: var(--glass-border-strong);
  background: var(--glass-fill-hover);
}

.liquid-button:active,
.top-action:active { transform: scale(.98); }
.liquid-button:disabled { opacity: .38; cursor: not-allowed; transform: none; }

.liquid-button.primary {
  color: var(--text);
  background: color-mix(in srgb, var(--accent) 66%, transparent);
  border-color: color-mix(in srgb, var(--accent) 64%, var(--glass-border));
  box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 10px 30px color-mix(in srgb, var(--accent) 24%, transparent);
}

:root[data-theme="light"] .liquid-button.primary {
  background: color-mix(in srgb, var(--accent) 82%, transparent);
  color: var(--accent-ink);
}

.liquid-button.secondary { background: var(--glass-fill-soft); }

@media (prefers-reduced-motion: reduce) {
  .liquid-button, .top-action, .rail-item { transform: none !important; }
}

@supports not ((backdrop-filter: blur(10px)) or (-webkit-backdrop-filter: blur(10px))) {
  :where(.liquid-panel, .liquid-button, .top-action, .chapter-rail, .rail-item.is-active) {
    background: var(--bg-elevated);
  }
}


